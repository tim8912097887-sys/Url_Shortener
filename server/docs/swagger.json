{
    "swagger": "2.0",
    "info": {
        "description": "Production-ready URL shortener API with JWT authentication, refresh-token rotation, and Google OAuth.\n\n## Authentication\nMost protected endpoints require an access token in the Authorization header:\n`Authorization: Bearer \u003caccess_token\u003e`\n\nAccess tokens are short-lived. Refresh tokens are stored in an HttpOnly cookie and used to obtain a new access token.\n\n## URL Expiration\nAuthenticated users receive longer URL expiration and cache durations.\nUnauthenticated URLs expire earlier.\n\n## Rate Limiting\nURL endpoints are rate limited to protect the service from abuse.",
        "title": "URL Shortener API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/urls": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns all shortened URLs owned by the authenticated user.\n\nOnly URLs created by the current authenticated user are returned.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "URLs"
                ],
                "summary": "Get current user's shortened URLs",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/urlschema.GetUrlsResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a shortened URL.\n\nThe URL expiration depends on authentication status:\n- Authenticated users: longer expiration period.\n- Anonymous users: shorter expiration period.\n",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "URLs"
                ],
                "summary": "Create a shortened URL",
                "parameters": [
                    {
                        "description": "URL to shorten",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/url.CreateUrlSchema"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/urlschema.ShortenUrlResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or URL",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/urls/{short_url}": {
            "get": {
                "description": "Resolves a shortened URL and redirects the client to the original destination.\n\nThe endpoint uses a cache-aside strategy:\n1. Redis cache is checked first.\n2. On cache miss, the URL is loaded from PostgreSQL.\n3. The result is cached with a TTL that never exceeds the URL expiration time.\n\nExpired URLs are treated as not found.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "URLs"
                ],
                "summary": "Resolve a shortened URL",
                "parameters": [
                    {
                        "type": "string",
                        "example": "abc12345",
                        "description": "Short URL code",
                        "name": "short_url",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "307": {
                        "description": "Temporary Redirect"
                    },
                    "400": {
                        "description": "Invalid short URL",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "URL not found or expired",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/login": {
            "post": {
                "description": "Authenticates a user with email and password.\n\nReturns a short-lived access token in the response body.\nA refresh token is stored in an HttpOnly Secure cookie.\n\nFor security, invalid email and invalid password return the same error.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/userschema.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/userschema.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Clears the refresh token cookie from the current browser.\n\nThis endpoint does not invalidate all tokens server-side.\nUse Logout All Sessions to invalidate tokens across devices.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Logout current device",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/userschema.LogoutResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/logout-all": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Invalidates all active access and refresh tokens for the user.\n\nThe user's token version is incremented, causing previously issued\naccess and refresh tokens to become invalid.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Logout all sessions",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/userschema.LogoutAllResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/refresh": {
            "post": {
                "description": "Issues a new access token using the refresh_token HttpOnly cookie.\n\nThe refresh token is rotated after a successful refresh.\nThe new refresh token is returned as a replacement HttpOnly Secure cookie.\n\nClients should call this endpoint when the access token expires.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Refresh access token",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/userschema.RefreshResponse"
                        }
                    },
                    "401": {
                        "description": "Missing, expired, or invalid refresh token",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/signup": {
            "post": {
                "description": "Registers a new user account.\n\nFor security, this endpoint returns the same successful response\nwhether the email is newly registered or already exists.\nThis prevents account enumeration.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Create user account",
                "parameters": [
                    {
                        "description": "Signup request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/userschema.SignupRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/userschema.SignupResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/envelope.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "envelope.Error": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "envelope.ErrorResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "$ref": "#/definitions/envelope.Error"
                },
                "metaData": {
                    "$ref": "#/definitions/envelope.MetaData"
                },
                "state": {
                    "type": "string"
                }
            }
        },
        "envelope.MetaData": {
            "type": "object",
            "properties": {
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "url.CreateUrlSchema": {
            "type": "object",
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "type": "string"
                }
            }
        },
        "urlschema.GetUrlsResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "urls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/urlschema.GetUrlsServiceResponse"
                    }
                }
            }
        },
        "urlschema.GetUrlsServiceResponse": {
            "type": "object",
            "properties": {
                "expired_at": {
                    "type": "string"
                },
                "long_url": {
                    "type": "string"
                },
                "short_url": {
                    "type": "string"
                }
            }
        },
        "urlschema.ShortenUrlResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "shortUrl": {
                    "type": "string"
                }
            }
        },
        "userschema.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                }
            }
        },
        "userschema.LoginResponse": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "userschema.LogoutAllResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "userschema.LogoutResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "userschema.RefreshResponse": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "userschema.SignupRequest": {
            "type": "object",
            "required": [
                "email",
                "password",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "password": {
                    "description": "bcrypt silently truncates/errors past 72 bytes, so cap it here.",
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8
                },
                "username": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                }
            }
        },
        "userschema.SignupResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter your access token in the format: Bearer {access_token}",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "RefreshCookie": {
            "description": "HttpOnly refresh token cookie automatically sent by the browser.",
            "type": "apiKey",
            "name": "refresh_token",
            "in": "cookie"
        }
    }
}